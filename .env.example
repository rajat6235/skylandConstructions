# Public base URL of the site, used for canonical URLs, sitemap and social cards.
# Must be the live domain so Google indexes the right URLs.
NEXT_PUBLIC_SITE_URL=https://skylandyxe.com

# Optional: Google Search Console verification code (HTML tag method, content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend (https://resend.com): form submissions are emailed to CONTACT_TO_EMAIL.
# The sending domain must be verified in Resend. Never commit real keys.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@skylandyxe.com
CONTACT_FROM_EMAIL=Skyland Website <website@skylandyxe.com>
